/// Restaurant Analytics Semantic Model
/// This model provides business intelligence for restaurant operations
/// Tables: fact_orders, fact_kitchen_flow, dim_stations, dim_channels, dim_order_status
/// Measures: KPIs and aggregations for dashboard and ontology

database RestaurantAnalytics
{
	culture "es-ES"
	compatibilityLevel 1701
	
	/// Tables imported from Lakehouse
	table fact_orders
	{
		lineageTag: "84b53c8f-1234-4567-89ab-cdef01234567"
		sourceLineageTag: "fact_orders"
		
		column order_id
		{
			dataType: string
			lineageTag: "f5a0e1c2-abcd-4321-bcde-f01234567890"
		}
		
		column order_date
		{
			dataType: datetime
			lineageTag: "a1b2c3d4-efgh-5678-ijkl-m01234567890"
			sortByColumn: order_date
		}
		
		column channel
		{
			dataType: string
			lineageTag: "b2c3d4e5-fghi-6789-jklm-n01234567890"
		}
		
		column status
		{
			dataType: string
			lineageTag: "c3d4e5f6-ghij-7890-klmn-o01234567890"
		}
		
		column delay_minutes
		{
			dataType: double
			lineageTag: "d4e5f6a7-hijk-8901-lmno-p01234567890"
		}
		
		column is_delayed
		{
			dataType: boolean
			lineageTag: "e5f6a7b8-ijkl-9012-mnop-q01234567890"
		}
		
		column is_on_sla
		{
			dataType: boolean
			lineageTag: "f6a7b8c9-jklm-0123-nopq-r01234567890"
		}
		
		column created_ts
		{
			dataType: datetime
			lineageTag: "a7b8c9d0-klmn-1234-opqr-s01234567890"
		}
		
		partition "Partition-fact_orders" =
			m => let
				Source = Lakehouse.Contents("[workspaceId]/[lakehouseId]/Tables/fact_orders")
			in
				Source
	}
	
	table fact_kitchen_flow
	{
		lineageTag: "95c64c9f-2345-5678-90ab-cdef12345678"
		sourceLineageTag: "fact_kitchen_flow"
		
		column flow_id
		{
			dataType: string
			lineageTag: "b6c7d8e9-mnop-2345-qrst-t01234567890"
		}
		
		column order_id
		{
			dataType: string
			lineageTag: "c7d8e9f0-nopq-3456-rstu-u01234567890"
		}
		
		column station_id
		{
			dataType: string
			lineageTag: "d8e9f0a1-opqr-4567-stuv-v01234567890"
		}
		
		column event_time
		{
			dataType: datetime
			lineageTag: "e9f0a1b2-pqrs-5678-tuvw-w01234567890"
		}
		
		column queue_length
		{
			dataType: int64
			lineageTag: "f0a1b2c3-qrst-6789-uvwx-x01234567890"
		}
		
		column processing_time_minutes
		{
			dataType: double
			lineageTag: "a1b2c3d4-rstu-7890-vwxy-y01234567890"
		}
		
		column saturation_pct
		{
			dataType: double
			lineageTag: "b2c3d4e5-stuv-8901-wxyz-z01234567890"
		}
		
		column created_ts
		{
			dataType: datetime
			lineageTag: "c3d4e5f6-tuvw-9012-xyza-a01234567890"
		}
		
		partition "Partition-fact_kitchen_flow" =
			m => let
				Source = Lakehouse.Contents("[workspaceId]/[lakehouseId]/Tables/fact_kitchen_flow")
			in
				Source
	}
	
	table fact_agent_decisions
	{
		lineageTag: "a6c74c9f-3456-6789-01bc-cdef23456789"
		sourceLineageTag: "fact_agent_decisions"
		
		column decision_id
		{
			dataType: string
			lineageTag: "d4e5f6a7-uvwx-0123-yzab-b01234567890"
		}
		
		column order_id
		{
			dataType: string
			lineageTag: "e5f6a7b8-vwxy-1234-zabc-c01234567890"
		}
		
		column decision_reason
		{
			dataType: string
			lineageTag: "f6a7b8c9-wxyz-2345-abcd-d01234567890"
		}
		
		column recommendation
		{
			dataType: string
			lineageTag: "a7b8c9d0-xyza-3456-bcde-e01234567890"
		}
		
		column priority
		{
			dataType: int64
			lineageTag: "b8c9d0e1-yzab-4567-cdef-f01234567890"
		}
		
		column created_ts
		{
			dataType: datetime
			lineageTag: "c9d0e1f2-zabc-5678-defg-g01234567890"
		}
		
		partition "Partition-fact_agent_decisions" =
			m => let
				Source = Lakehouse.Contents("[workspaceId]/[lakehouseId]/Tables/fact_agent_decisions")
			in
				Source
	}
	
	table dim_stations
	{
		lineageTag: "b7d85d0g-4567-7890-12cd-cdef34567890"
		sourceLineageTag: "dim_stations"
		
		column station_id
		{
			dataType: string
			lineageTag: "d5e6f7a8-abcd-6789-defg-h01234567890"
		}
		
		column station_name
		{
			dataType: string
			lineageTag: "e6f7a8b9-bcde-7890-efgh-i01234567890"
		}
		
		column capacity
		{
			dataType: int64
			lineageTag: "f7a8b9c0-cdef-8901-fghi-j01234567890"
		}
		
		column created_ts
		{
			dataType: datetime
			lineageTag: "a8b9c0d1-defg-9012-ghij-k01234567890"
		}
		
		partition "Partition-dim_stations" =
			m => let
				Source = Lakehouse.Contents("[workspaceId]/[lakehouseId]/Tables/dim_stations")
			in
				Source
	}
	
	table dim_channels
	{
		lineageTag: "c8e96e1h-5678-8901-23de-cdef45678901"
		sourceLineageTag: "dim_channels"
		
		column channel_id
		{
			dataType: string
			lineageTag: "e6f7a8b9-efgh-9012-ijkl-l01234567890"
		}
		
		column channel_name
		{
			dataType: string
			lineageTag: "f7a8b9c0-fghi-0123-jklm-m01234567890"
		}
		
		column sla_minutes
		{
			dataType: int64
			lineageTag: "a8b9c0d1-ghij-1234-klmn-n01234567890"
		}
		
		column created_ts
		{
			dataType: datetime
			lineageTag: "b9c0d1e2-hijk-2345-lmno-o01234567890"
		}
		
		partition "Partition-dim_channels" =
			m => let
				Source = Lakehouse.Contents("[workspaceId]/[lakehouseId]/Tables/dim_channels")
			in
				Source
	}
	
	table dim_order_status
	{
		lineageTag: "d9f97f2i-6789-9012-34ef-cdef56789012"
		sourceLineageTag: "dim_order_status"
		
		column status_id
		{
			dataType: string
			lineageTag: "f7a8b9c0-ijkl-3456-mnop-p01234567890"
		}
		
		column status_name
		{
			dataType: string
			lineageTag: "a8b9c0d1-jklm-4567-nopq-q01234567890"
		}
		
		column status_sequence
		{
			dataType: int64
			lineageTag: "b9c0d1e2-klmn-5678-opqr-r01234567890"
		}
		
		column is_terminal
		{
			dataType: boolean
			lineageTag: "c0d1e2f3-lmno-6789-pqrs-s01234567890"
		}
		
		partition "Partition-dim_order_status" =
			m => let
				Source = Lakehouse.Contents("[workspaceId]/[lakehouseId]/Tables/dim_order_status")
			in
				Source
	}
	
	/// Calculated table for KPIs
	table KPIs
	{
		lineageTag: "eaa08g3j-7890-0123-45fg-cdef67890123"
		description "Business KPI measures and calculated metrics"
		
		column PedidosTotales
		{
			dataType: int64
			lineageTag: "d0e1f2a3-mnop-7890-qrst-t01234567890"
		}
		
		column PedidosAtrasados
		{
			dataType: int64
			lineageTag: "e1f2a3b4-nopq-8901-rstu-u01234567890"
		}
		
		column AtrasoMedioMinutos
		{
			dataType: double
			lineageTag: "f2a3b4c5-opqr-9012-stuv-v01234567890"
		}
		
		column PedidosEnSLA
		{
			dataType: int64
			lineageTag: "a3b4c5d6-pqrs-0123-tuvw-w01234567890"
		}
		
		column TiempoMedioCocinaMinutos
		{
			dataType: double
			lineageTag: "b4c5d6e7-qrst-1234-uvwx-x01234567890"
		}
		
		column ColaMediaEstacion
		{
			dataType: double
			lineageTag: "c5d6e7f8-rstu-2345-vwxy-y01234567890"
		}
		
		column SLAPct
		{
			dataType: double
			lineageTag: "d6e7f8a9-stuv-3456-wxyz-z01234567890"
		}
		
		measure PedidosTotalMeasure
		{
			expression = COALESCE(COUNTROWS(fact_orders), 0)
			formatString = "#,##0"
			lineageTag: "e7f8a9b0-tuvw-4567-xyza-a01234567890"
		}
		
		measure AtrasoMedioMeasure
		{
			expression = AVERAGE(fact_orders[delay_minutes])
			formatString = "0.00"
			lineageTag: "f8a9b0c1-uvwx-5678-yzab-b01234567890"
		}
		
		measure PedidosEnSLAMeasure
		{
			expression = CALCULATE([PedidosTotalMeasure], FILTER(fact_orders, fact_orders[is_on_sla]=TRUE()))
			formatString = "#,##0"
			lineageTag: "a9b0c1d2-vwxy-6789-zabc-c01234567890"
		}
		
		measure SLAPctMeasure
		{
			expression = DIVIDE([PedidosEnSLAMeasure], [PedidosTotalMeasure], 0)
			formatString = "0.00%"
			lineageTag: "b0c1d2e3-wxyz-7890-abcd-d01234567890"
		}
		
		measure ColaMediaEstacionMeasure
		{
			expression = AVERAGE(fact_kitchen_flow[queue_length])
			formatString = "0.00"
			lineageTag: "c1d2e3f4-xyza-8901-bcde-e01234567890"
		}
		
		partition "Partition-KPIs" =
			m => let
				Source = Table.FromRows({})
			in
				Source
	}
	
	/// Relationships (star schema)
	relationship fact_orders_to_dim_channels
	{
		fromColumn: fact_orders[channel]
		toColumn: dim_channels[channel_id]
		fromCardinality: many
		toCardinality: one
		isActive: true
		lineageTag: "d2e3f4a5-yzab-9012-cdef-f01234567890"
	}
	
	relationship fact_orders_to_dim_order_status
	{
		fromColumn: fact_orders[status]
		toColumn: dim_order_status[status_id]
		fromCardinality: many
		toCardinality: one
		isActive: true
		lineageTag: "e3f4a5b6-zabc-0123-defg-g01234567890"
	}
	
	relationship fact_kitchen_flow_to_dim_stations
	{
		fromColumn: fact_kitchen_flow[station_id]
		toColumn: dim_stations[station_id]
		fromCardinality: many
		toCardinality: one
		isActive: true
		lineageTag: "f4a5b6c7-abcd-1234-efgh-h01234567890"
	}
	
	relationship fact_agent_decisions_to_fact_orders
	{
		fromColumn: fact_agent_decisions[order_id]
		toColumn: fact_orders[order_id]
		fromCardinality: many
		toCardinality: one
		isActive: true
		lineageTag: "a5b6c7d8-bcde-2345-fghi-i01234567890"
	}
	
	annotation __PBI_TimeIntelligenceEnabled = 0
	annotation PBI_QueryFolding = 0
}
