table fact_orders

	column order_id
		dataType: string
		isKey
		summarizeBy: none
		sourceColumn: order_id

	column order_date
		dataType: datetime
		summarizeBy: none
		sourceColumn: order_date

	column order_hour
		dataType: int64
		summarizeBy: none
		sourceColumn: order_hour

	column channel
		dataType: string
		summarizeBy: none
		sourceColumn: channel

	column status
		dataType: string
		summarizeBy: none
		sourceColumn: status

	column created_at
		dataType: datetime
		summarizeBy: none
		sourceColumn: created_at

	column completed_at
		dataType: datetime
		summarizeBy: none
		sourceColumn: completed_at

	column delay_minutes
		dataType: double
		summarizeBy: none
		sourceColumn: delay_minutes

	column is_delayed
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_delayed

	column is_on_sla
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_on_sla

	column total_items
		dataType: int64
		summarizeBy: none
		sourceColumn: total_items

	column priority
		dataType: string
		summarizeBy: none
		sourceColumn: priority

	column station_id
		dataType: string
		summarizeBy: none
		sourceColumn: station_id
	
	column created_ts
		dataType: datetime
		summarizeBy: none
		sourceColumn: created_ts
	
	partition fact_orders = entity
		mode: directLake
		source
			entityName: fact_orders
			schemaName: dbo
			expressionSource: DL_Lakehouse
